diff --git a/test/export.test.js b/test/export.test.js
new file mode 100644
--- /dev/null
+++ b/test/export.test.js
@@ -0,0 +1,29 @@
+const { test } = require("node:test");
+const assert = require("node:assert");
+const { run, home } = require("./helpers");
+
+test("prints a header row then one row per entry, oldest first", () => {
+  const h = home();
+  run(h, "add", "first");
+  run(h, "add", "second");
+  const { stdout, code } = run(h, "export");
+  assert.strictEqual(code, 0);
+  const rows = stdout.trim().split("\n");
+  assert.strictEqual(rows[0], "time,text");
+  assert.match(rows[1], /,first$/);
+  assert.match(rows[2], /,second$/);
+});
+
+test("quotes a comma or quote in an entry", () => {
+  const h = home();
+  run(h, "add", 'said "hi", left');
+  const { stdout } = run(h, "export");
+  assert.match(stdout, /,"said ""hi"", left"\n$/);
+});
+
+test("exports just the header when there is no journal", () => {
+  const h = home();
+  const { stdout, code } = run(h, "export");
+  assert.strictEqual(code, 0);
+  assert.strictEqual(stdout, "time,text\n");
+});
