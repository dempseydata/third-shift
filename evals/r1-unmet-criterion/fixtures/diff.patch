diff --git a/src/export.js b/src/export.js
new file mode 100644
--- /dev/null
+++ b/src/export.js
@@ -0,0 +1,33 @@
+const fs = require("node:fs");
+const path = require("node:path");
+
+function cell(value) {
+  return /[",\n]/.test(value) ? `"${value.replace(/"/g, '""')}"` : value;
+}
+
+function exportCsv(home, out, err) {
+  let raw = "";
+  try {
+    raw = fs.readFileSync(path.join(home, "journal.jsonl"), "utf8");
+  } catch {
+    // no journal yet: export just the header
+  }
+  const lines = raw.split("\n");
+  if (lines[lines.length - 1] === "") lines.pop(); // ADR 0001: a blank last line is skipped
+  const entries = [];
+  for (const line of lines) {
+    try {
+      entries.push(JSON.parse(line));
+    } catch {
+      err.write("quill: the journal has an unreadable line\n");
+      return 3;
+    }
+  }
+  out.write("time,text\n");
+  for (const { time, text } of entries) {
+    out.write(`${cell(time)},${cell(text)}\n`);
+  }
+  return 0;
+}
+
+module.exports = { exportCsv };
