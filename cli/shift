#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""The state script (ADR 0003): the only writer of a shift's ledger and runtime state.

Run from the target repo's folder as `uv run --script "${CLAUDE_PLUGIN_ROOT}/cli/shift" <cmd>`.
Every command prints one JSON object on stdout; exit 0 done, 1 refused, 2 lease lost.

  arm --prescan <file> --sitting <file> --mode day|away [--ceiling N|none]
  next --gen N
  admit <ticket> --gen N READINGS   applies the usage gate for the implementer, then admits
  step <ticket> --begin --gen N --role R READINGS   the usage gate at a later step boundary
  step <ticket> --gen N --role R --round K --model M --effort E --before-5h P --before-weekly P
       --after-5h P --after-weekly P --start ISO --end ISO --tokens T --outcome TEXT
  pause --gen N --reason usage|owner --until ISO   (the reset time)
  resume --gen N
  done <ticket> --gen N --comment <file>   file: [{"criterion", "verdict", "evidence_url"}]
  needs-you <ticket> --gen N --reason blocker|human-verify|human|"set aside after a crash" --why W
  stall <ticket> --gen N --why W
  release <ticket> --gen N [--decision D]
  note decision|owed|nit <ticket> --gen N --text T [--for <later ticket>]   --for only, and
       always, for owed
  wait --gen N
  end --gen N --reason R   applies the sitting's end state, then disarms
  heartbeat   the hook's entry point (hooks/hooks.json): reads the hook's JSON on stdin; the
       first hook after arm or revive claims the lease for its session_id (ADR 0004)
  is-dead     for the watchman: {"dead": bool, "why"}
  revive      takes over a dead shift: raises the lease, sets uncommitted work aside on
       refs/third-shift/<spec-slug>/set-aside-<gen>, restarts the ticket from its last commit

READINGS, from the desktop app's usage tool (whole percent used):
  --5h P --reset ISO --weekly P [--weekly P ..] --guess G   one --weekly per weekly window
  --unreadable --guess G                                     when the tool did not answer
  --guess is the role's starting cost from the role table, used until the role has steps.
The gate answers {"gate": "proceed"|"pause-until"|"retry"|"end", "reason", "until",
"retry_in_minutes", "estimate": {"points", "guess"}}; `step --begin` exits 0 with any answer,
`admit` exits 1 (refused) with any answer but proceed.

prescan.json (written by cli/prescan):
  {"spec": {"number", "title"}, "repo": "owner/name", "base_commit": sha,
   "tickets": [{"number", "title", "state": "open"|"closed", "labels": [..],
                "blocked_by": [issue numbers, native links only], "criteria": [text, ..]}],
   "checks": [{"name", "ok": bool, "detail"}], "warnings": [text, ..],
   "baseline_seconds": float, "proven_commit": sha}

sitting.json (written by the start skill's decision sitting):
  {"classes": {"<ticket>": "agent"|"human-verified"|"human"},  overrides the triage label
   "gaps": [{"question", "answer", "adr": path}], "end_state": "branch"|"fast-forward",
   "binding_sources": [in precedence order], "warnings": [text, ..]}

Runtime state lives in $THIRD_SHIFT_HOME (default ~/.third-shift)/<owner>/<repo>/: state.json,
heartbeat, refusals.jsonl, and copies of prescan.json and sitting.json. THIRD_SHIFT_NOW (ISO,
with a timezone) stands in for the clock.
The ledger is docs/third-shift-ledger/<spec-slug>.json (and .md) in the target, on the
branch third-shift/<spec-slug>, where spec-slug is "<number>-<title, slugified>".
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
from contextlib import suppress
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import unquote

PLUGIN = Path(__file__).resolve().parent.parent
THRESHOLD = {"day": 90, "away": 98}
RESERVE = 5
CEILING = 80
LOOK_BACK = 5  # steps of a role the look-ahead takes its largest cost from
RETRY_MINUTES = 10
UNREADABLE_LIMIT = 3
SILENCE = timedelta(minutes=20)  # spec: Revival, dead
PAUSE_GRACE = timedelta(minutes=15)
CRASHES = 2  # a ticket in progress during this many crashes needs the builder
REVIVALS = 3  # the revival that ends the shift
CLASS_BY_LABEL = {"ready-for-human": "human", "ready-for-agent": "agent"}
CLASSES = ("agent", "human-verified", "human")
ROLES = ("prescan", "implementer", "reviewer", "fixer", "verifier")  # GLOSSARY: Role
VERDICTS = ("met", "not met", "needs your run")  # ADR 0003
STATES = ("Backlog", "Ready", "In progress", "Needs you", "Stalled", "Done")  # spec: States
REASONS = ("blocker", "human-verify", "human", "set aside after a crash")  # spec: needs-you


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def refuse(why):
    out({"ok": False, "refused": why}, 1)


def run(*cmd, env=None):
    return subprocess.run(cmd, check=True, capture_output=True, text=True, env=env).stdout.strip()


def home():
    return Path(os.environ.get("THIRD_SHIFT_HOME", Path.home() / ".third-shift"))


def runtime(repo):
    if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo) or {".", ".."} & set(repo.split("/")):
        refuse(f"not an owner/repo name: {repo}")
    return home() / repo / "state.json"


def ledger_path(spec):
    slug = re.sub(r"[^a-z0-9]+", "-", spec["title"].lower()).strip("-")
    return Path("docs/third-shift-ledger") / (f"{spec['number']}-{slug}".rstrip("-") + ".json")


def frontier_state(blockers):
    return "Backlog" if any(b["state"] == "open" for b in blockers) else "Ready"


def write_ledger(path, ledger):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(ledger, indent=2) + "\n")
    o = ledger["opening"]
    rows = [f"| #{t['number']} | {t['title']} | {t['class']} | {ledger['tickets'][str(t['number'])]['state']} |"
            for t in o["tickets"]]
    path.with_suffix(".md").write_text("\n".join([
        f"# Ledger: #{o['spec']['number']} {o['spec']['title']}", "",
        "Generated from the JSON beside it by the state script; do not edit.", "",
        f"Branch `{o['branch']}` from `{o['base_commit']}` · third-shift {o['version']} · "
        f"{o['mode']} mode, threshold {o['threshold']}%, ceiling "
        f"{'waived' if o['ceiling'] is None else str(o['ceiling']) + '%'} · end state {o['end_state']}",
        "", "| Ticket | Title | Class | State |", "| --- | --- | --- | --- |", *rows, ""]))


def commit_ledger(path, branch, message, *also):
    paths = [str(path), str(path.with_suffix(".md"))]
    if run("git", "status", "--porcelain", "--", *paths):
        run("git", "add", *paths)
        run("git", "commit", "-q", "-m", message, "--", *paths)  # only the ledger, never staged work
    # even when unchanged: retries a failed push; atomic, so `also` refs move with it or not at all
    run("git", "push", "-q", "-u", "--atomic", "origin", branch, *also)


def arm(a):
    prescan = json.loads(Path(a.prescan).read_text())
    sitting = json.loads(Path(a.sitting).read_text())
    state_file = runtime(prescan["repo"])
    if state_file.exists() and json.loads(state_file.read_text()).get("armed"):
        refuse(f"a shift is already armed for {prescan['repo']}")
    ceiling = None if a.ceiling == "none" else int(a.ceiling)
    if ceiling is not None and not 0 <= ceiling <= 100:
        refuse(f"the ceiling must be 0 to 100, or none: {a.ceiling}")
    failed = [c["name"] for c in prescan["checks"] if not c["ok"]]
    if failed:
        refuse(f"checks failed: {', '.join(failed)}")
    unanswered = [g["question"] for g in sitting["gaps"] if not (g.get("answer") or "").strip()]
    if unanswered:
        refuse(f"gaps unanswered: {'; '.join(unanswered)}")
    tickets = []
    done = {t["number"] for t in prescan["tickets"] if t["state"] == "closed"}
    for t in prescan["tickets"]:
        cls = sitting["classes"].get(str(t["number"])) or next(
            (CLASS_BY_LABEL[l] for l in t["labels"] if l in CLASS_BY_LABEL), None)
        if not cls:
            refuse(f"ticket #{t['number']} is unclassed")
        if cls not in CLASSES:
            refuse(f"ticket #{t['number']} has an unknown class: {cls}")
        # a blocker outside the ticket set counts as open until `next` reads its state
        state = ("Done" if t["state"] == "closed" else "Needs you" if cls == "human"
                 else frontier_state([{"state": "open"} for b in t["blocked_by"] if b not in done]))
        tickets.append({"number": t["number"], "title": t["title"], "class": cls,
                        "starting_state": state, "blocked_by": t["blocked_by"],
                        "criteria": t["criteria"]})
    if run("git", "rev-parse", "HEAD") != prescan["base_commit"]:
        refuse("the base commit has moved since the prescan")

    spec = prescan["spec"]
    rel = ledger_path(spec)
    top = run("git", "rev-parse", "--show-toplevel")
    path = Path(top) / rel
    branch = f"third-shift/{path.stem}"
    ledger = {
        "opening": {
            "spec": spec, "repo": prescan["repo"], "branch": branch,
            "base_commit": prescan["base_commit"],
            "version": json.loads((PLUGIN / ".claude-plugin" / "plugin.json").read_text())["version"],
            "mode": a.mode, "threshold": THRESHOLD[a.mode], "reserve": RESERVE,
            "ceiling": ceiling, "end_state": sitting["end_state"],
            "baseline_seconds": prescan["baseline_seconds"],
            "proven_commit": prescan["proven_commit"],
            "binding_sources": sitting["binding_sources"], "gaps": sitting["gaps"],
            "warnings": prescan["warnings"] + sitting["warnings"],
            "tickets": tickets,
        },
        "tickets": {str(t["number"]): {"state": t["starting_state"]} for t in tickets},
    }
    copies = {state_file.with_name(f"{n}.json"): Path(f).read_text()
              for n, f in (("prescan", a.prescan), ("sitting", a.sitting))}
    prior = {f: f.read_text() if f.exists() else None for f in (state_file, *copies)}  # rollback
    was_on = run("git", "branch", "--show-current") or prescan["base_commit"]
    run("git", "checkout", "-q", "-b", branch, prescan["base_commit"])
    md = path.with_suffix(".md")
    try:
        write_ledger(path, ledger)
        state_file.parent.mkdir(parents=True, exist_ok=True)
        for f, content in copies.items():  # spec: Records, kept on the Mac
            f.write_text(content)
        state_file.write_text(json.dumps({
            "armed": True, "gen": 1, "spec": spec["number"], "ledger": str(rel),
            "shift_state": "running", "since": now(),
            "target": top}) + "\n")  # the heartbeat's claim checks the folder
        commit_ledger(path, branch, f"ledger: #{spec['number']} armed")  # the push is last
    except Exception:  # leave nothing behind, so arm can run again
        subprocess.run(["git", "rm", "-q", "-f", "--cached", "--ignore-unmatch", "--",
                        str(path), str(md)], capture_output=True)
        for f, content in prior.items():
            if content is not None:
                f.write_text(content)
        for f in (path, md, *(f for f, c in prior.items() if c is None)):
            with suppress(OSError):
                f.unlink()
        for d in (state_file.parent, path.parent):
            with suppress(OSError):
                os.removedirs(d)  # only the folders left empty
        subprocess.run(["git", "checkout", "-q", was_on], capture_output=True)
        subprocess.run(["git", "branch", "-q", "-D", branch], capture_output=True)
        raise
    out({"ok": True, "gen": 1, "branch": branch, "ledger": str(rel)})


def gh_list(path):
    return [json.loads(l) for l in run("gh", "api", "--paginate", path, "--jq", ".[]").splitlines()]


def this_repo():
    return json.loads(run("gh", "repo", "view", "--json", "nameWithOwner"))["nameWithOwner"]


def load(gen=None):
    """The armed shift's repo, ledger path and ledger, after the lease and branch checks."""
    repo = this_repo()
    state_file = runtime(repo)
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    if not state.get("armed"):
        refuse(f"no shift is armed for {repo}")
    if gen is not None and gen != state["gen"]:
        with state_file.with_name("refusals.jsonl").open("a") as f:  # spec: refused and logged
            f.write(json.dumps({"at": now(), "command": sys.argv[1], "gen": gen,
                                "lease": state["gen"]}) + "\n")
        out({"ok": False, "lease": "lost", "stop": True,
             "refused": f"--gen {gen} is stale; the lease is at generation {state['gen']}"}, 2)
    branch = f"third-shift/{Path(state['ledger']).stem}"  # checked before the ledger is read
    top, on = run("git", "rev-parse", "--show-toplevel", "--abbrev-ref", "HEAD").splitlines()
    if on != branch:  # one git call for both: every command pays for each process
        refuse(f"not on the shift branch {branch}")
    path = Path(top) / state["ledger"]
    return repo, path, json.loads(path.read_text())


def next_(a):
    repo, path, ledger = load(a.gen)
    spec = ledger["opening"]["spec"]["number"]
    closed = {i["number"] for i in gh_list(f"repos/{repo}/issues/{spec}/sub_issues")
              if i["state"] == "closed"}
    for n, t in ledger["tickets"].items():
        if int(n) in closed:
            t["state"] = "Done"
        elif t["state"] in ("Backlog", "Ready"):
            t["state"] = frontier_state(gh_list(f"repos/{repo}/issues/{n}/dependencies/blocked_by"))
    write_ledger(path, ledger)
    commit_ledger(path, ledger["opening"]["branch"], f"ledger: #{spec} frontier")
    first = next((t for t in ledger["opening"]["tickets"]
                  if ledger["tickets"][str(t["number"])]["state"] == "Ready"), None)
    out({"ok": True, "ticket": first and {"number": first["number"], "title": first["title"]},
         **({} if first else {"frontier": "empty"})})


def save(path, ledger, message, *also):
    """Write, commit and push the ledger; on any failure put the files, index and HEAD back."""
    md = path.with_suffix(".md")
    prior = path.read_text(), md.read_text(), run("git", "rev-parse", "HEAD")
    try:
        write_ledger(path, ledger)
        commit_ledger(path, ledger["opening"]["branch"], message, *also)
    except Exception:  # a refusal writes nothing
        subprocess.run(["git", "reset", "-q", "--soft", prior[2]], capture_output=True)
        subprocess.run(["git", "reset", "-q", "--", str(path), str(md)], capture_output=True)
        path.write_text(prior[0])
        md.write_text(prior[1])
        raise


def ticket(ledger, n, *states):
    t = ledger["tickets"].get(str(n))
    if t is None:
        refuse(f"#{n} is not a ticket of this shift")
    if t["state"] not in states:
        refuse(f"#{n} is {t['state']}, not {' or '.join(states)}")
    return t


def criteria(body):
    """The checkbox lines under a ticket's `## Acceptance criteria` heading."""
    m = re.search(r"^## Acceptance criteria[ \t]*$(.*?)(?=^#|\Z)", body.replace("\r", ""), re.M | re.S)
    return re.findall(r"^\s*[-*] \[[ xX]\] (.+?)\s*$", m.group(1) if m else "", re.M)


def gate(a, repo, ledger, role, limit):
    """The usage gate (spec: Usage gate) for the next step of `role`, below `limit`."""
    readings = [f for f in ("five_hour", "reset", "weekly") if getattr(a, f) is not None]
    if a.guess is None:
        refuse("--guess, the role's starting cost from the role table, is required")
    if a.unreadable == bool(readings) or not (a.unreadable or len(readings) == 3):
        refuse("give --5h, --reset and --weekly, or --unreadable alone")
    state_file = runtime(repo)  # the failure count survives between boundaries
    state = json.loads(state_file.read_text())
    if state["shift_state"] == "paused":
        return {"gate": "pause-until", "until": state["until"],
                "reason": f"the shift is paused until {state['until']}"}
    failures = state.get("unreadable", 0) + 1 if a.unreadable else 0
    if failures != state.get("unreadable", 0):
        state_file.write_text(json.dumps({**state, "unreadable": failures}) + "\n")
    if a.unreadable:
        if failures >= UNREADABLE_LIMIT:
            return {"gate": "end", "reason": f"usage unreadable {failures} times in a row"}
        return {"gate": "retry", "retry_in_minutes": RETRY_MINUTES, "reason": "usage unreadable"}
    ceiling, weekly = ledger["opening"]["ceiling"], max(a.weekly)
    if ceiling is not None and weekly >= ceiling:
        return {"gate": "end", "reason": f"weekly usage {weekly}% reached the ceiling {ceiling}%"}
    costs = [s["points"] for s in ledger.get("steps", []) if s["role"] == role][-LOOK_BACK:]
    estimate = {"points": max(costs) if costs else a.guess, "guess": not costs}
    limit = min(limit, 99)  # map ticket #6: the gate never reaches 100%, reserve or not
    if a.five_hour >= limit:
        why = f"5-hour usage {a.five_hour}% reached {limit}%"
    elif a.five_hour + estimate["points"] >= 100:
        why = f"5-hour usage {a.five_hour}% plus a {role} step of {estimate['points']} reaches 100%"
    else:
        return {"gate": "proceed", "estimate": estimate}
    return {"gate": "pause-until", "until": a.reset, "reason": why, "estimate": estimate}


def admit(a):
    repo, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "Ready")
    busy = [n for n, u in ledger["tickets"].items() if u["state"] == "In progress"]
    if busy:
        refuse(f"#{busy[0]} is already in progress; a shift works one ticket at a time")
    g = gate(a, repo, ledger, "implementer", ledger["opening"]["threshold"])  # a ticket's first step
    if g["gate"] != "proceed":
        out({"ok": False, "refused": g["reason"], **g}, 1)
    body = json.loads(run("gh", "api", f"repos/{repo}/issues/{a.ticket}"))["body"] or ""
    frozen = next(o["criteria"] for o in ledger["opening"]["tickets"] if o["number"] == a.ticket)
    if criteria(body) == frozen:
        t["state"], event = "In progress", "admitted"
    else:
        t.update(state="Needs you", reason="blocker",
                 why="its acceptance criteria changed after the prescan froze them")
        event = "needs you"
    save(path, ledger, f"ledger: #{a.ticket} {event}")
    out({"ok": True, "ticket": a.ticket, **t, "estimate": g["estimate"]})


RECORD = ("round", "model", "effort", "outcome", "before_5h", "before_weekly", "after_5h",
          "after_weekly", "start", "end", "tokens")


def step(a):
    repo, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "In progress")
    if a.begin:  # an admitted ticket's later steps may use the reserve
        o = ledger["opening"]
        out({"ok": True, "ticket": a.ticket, **gate(a, repo, ledger, a.role,
                                                    o["threshold"] + o["reserve"])})
    missing = [f"--{f.replace('_', '-')}" for f in RECORD if getattr(a, f) is None]
    if missing:
        refuse(f"a step record needs {', '.join(missing)}")
    if datetime.fromisoformat(a.end) < datetime.fromisoformat(a.start):
        refuse(f"--end {a.end} is before --start {a.start}")
    points = a.after_5h - a.before_5h  # whole points; usage is account-wide
    ledger.setdefault("steps", []).append({
        "ticket": a.ticket, "role": a.role, "round": a.round, "model": a.model,
        "effort": a.effort, "before": {"5h": a.before_5h, "weekly": a.before_weekly},
        "after": {"5h": a.after_5h, "weekly": a.after_weekly},
        "start": a.start, "end": a.end, "tokens": a.tokens, "outcome": a.outcome,
        # the window reset during the step: only the new window's points are known
        **({"points": points} if points >= 0 else {"points": a.after_5h, "lower_bound": True})})
    t["usage"] = t.get("usage", 0) + ledger["steps"][-1]["points"]
    save(path, ledger, f"ledger: #{a.ticket} step")
    out({"ok": True, "step": ledger["steps"][-1]})


def done(a):
    repo, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "In progress")
    rows = json.loads(Path(a.comment).read_text())
    frozen = next(o["criteria"] for o in ledger["opening"]["tickets"] if o["number"] == a.ticket)
    if not frozen:
        refuse(f"#{a.ticket} has no frozen criteria to close against")
    if not isinstance(rows, list) or sorted(r.get("criterion") for r in rows) != sorted(frozen):
        refuse(f"#{a.ticket} needs exactly one row per frozen criterion: {frozen}")
    pinned = re.compile(rf"https://github\.com/{re.escape(repo)}/blob/([0-9a-f]{{40}})/([^#?\s]+)"
                        r"(?:#L[1-9]\d*(?:-L[1-9]\d*)?)?")
    top = run("git", "rev-parse", "--show-toplevel")  # git resolves ./ and ../ against the cwd
    for r in rows:
        if r.get("verdict") not in VERDICTS:
            refuse(f"no verdict for {r['criterion']!r}; one of {', '.join(VERDICTS)}")
        m = pinned.fullmatch(r.get("evidence_url") or "")
        file = m and unquote(m[2])
        kind = (m and not {"", ".", ".."} & set(file.split("/"))
                and Path(top, file) not in (path, path.with_suffix(".md"))
                and subprocess.run(["git", "cat-file", "-t", f"{m[1]}:{file}"], cwd=top,
                                   capture_output=True, text=True).stdout.strip())
        if kind != "blob" or subprocess.run(  # on the shift branch, so the permalink resolves
                ["git", "merge-base", "--is-ancestor", m[1], "HEAD"], capture_output=True).returncode:
            refuse(f"no commit-pinned evidence in this repo for {r['criterion']!r}")
        if r["verdict"] == "not met":
            refuse(f"{r['criterion']!r} is not met")
    unrun = [r["criterion"] for r in rows if r["verdict"] == "needs your run"]
    t["verdicts"] = rows
    if unrun:
        t.update(state="Needs you", reason="human-verify",
                 why=f"needs your run: {'; '.join(unrun)}")
    else:
        t["state"] = "Done"
    save(path, ledger, f"ledger: #{a.ticket} {t['state'].lower()}")
    cell = lambda s: s.replace("|", "\\|")
    out({"ok": True, "ticket": a.ticket, **t, "comment": "\n".join([
        "| Criterion | Verdict | Evidence |", "| --- | --- | --- |",
        *(f"| {cell(r['criterion'])} | {r['verdict']} | [evidence]({r['evidence_url']}) |"
          for r in rows)])})


def needs_you(a):
    _, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "In progress")
    t.update(state="Needs you", reason=a.reason, why=a.why)
    save(path, ledger, f"ledger: #{a.ticket} needs you")
    out({"ok": True, "ticket": a.ticket, **t})


def stall(a):
    _, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "In progress")
    t.update(state="Stalled", why=a.why)
    save(path, ledger, f"ledger: #{a.ticket} stalled")
    out({"ok": True, "ticket": a.ticket, **t})


def release(a):
    repo, path, ledger = load(a.gen)
    t = ticket(ledger, a.ticket, "Needs you")
    t.setdefault("released", []).append(  # the question stays beside the builder's answer
        {"reason": t.pop("reason", None), "why": t.pop("why", None), "decision": a.decision})
    t["state"] = frontier_state(gh_list(f"repos/{repo}/issues/{a.ticket}/dependencies/blocked_by"))
    save(path, ledger, f"ledger: #{a.ticket} released")
    state_file = runtime(repo)  # work is back on the frontier, so waiting is over
    state = json.loads(state_file.read_text())
    if state["shift_state"] == "waiting":
        state_file.write_text(json.dumps({**state, "shift_state": "running"}) + "\n")
    out({"ok": True, "ticket": a.ticket, **t})


def note(a):
    _, path, ledger = load(a.gen)
    ticket(ledger, a.ticket, *STATES)
    if (a.kind == "owed") != (a.for_ is not None):
        refuse("an owed finding, and only an owed finding, names its later ticket with --for")
    if a.for_ is not None:
        ticket(ledger, a.for_, *STATES[:-1])  # Done can carry nothing
        if a.for_ == a.ticket:
            refuse(f"#{a.ticket} cannot owe a finding to itself")
    ledger.setdefault("notes", []).append({"kind": a.kind, "ticket": a.ticket, "text": a.text,
                                           **({"for": a.for_} if a.for_ else {})})
    save(path, ledger, f"ledger: #{a.ticket} {a.kind}")
    out({"ok": True, "note": ledger["notes"][-1]})


def wait(a):
    repo, _, ledger = load(a.gen)
    state_file = runtime(repo)
    state = json.loads(state_file.read_text())
    if state["shift_state"] != "running":
        refuse(f"the shift is {state['shift_state']}, not running")
    moving = [f"#{n} is {t['state']}" for n, t in ledger["tickets"].items()
              if t["state"] not in ("Needs you", "Stalled", "Done")]
    if moving:
        refuse(f"tickets can still move: {', '.join(moving)}")
    state_file.write_text(json.dumps({**state, "shift_state": "waiting"}) + "\n")
    out({"ok": True, "shift_state": "waiting"})


def pause(a):
    repo, path, ledger = load(a.gen)
    state_file = runtime(repo)
    state = json.loads(state_file.read_text())
    if state["shift_state"] != "running":
        refuse(f"the shift is {state['shift_state']}, not running")
    ledger.setdefault("pauses", []).append({"reason": a.reason, "until": a.until, "at": now()})
    save(path, ledger, f"ledger: #{ledger['opening']['spec']['number']} paused")
    state_file.write_text(json.dumps({**state, "shift_state": "paused", "until": a.until,
                                      "pause": a.reason}) + "\n")
    out({"ok": True, "shift_state": "paused", "until": a.until})


def resume(a):
    repo, path, ledger = load(a.gen)
    state_file = runtime(repo)
    state = json.loads(state_file.read_text())
    if state["shift_state"] != "paused":
        refuse(f"the shift is {state['shift_state']}, not paused")
    ledger["pauses"][-1]["resumed"] = now()
    save(path, ledger, f"ledger: #{ledger['opening']['spec']['number']} resumed")
    state.pop("until", None)
    state.pop("pause", None)
    state_file.write_text(json.dumps({**state, "shift_state": "running"}) + "\n")
    out({"ok": True, "shift_state": "running"})


def now():
    return (os.environ.get("THIRD_SHIFT_NOW")  # the suite's clock
            or datetime.now(timezone.utc).isoformat(timespec="seconds"))


def end(a):
    finish(*load(a.gen), a.reason)


def finish(repo, path, ledger, reason, **extra):
    o = ledger["opening"]
    also = []
    if o["end_state"] == "fast-forward":  # spec: the end state is applied at `end`
        head = re.search(r"^ref: refs/heads/(\S+)\tHEAD$",
                         run("git", "ls-remote", "--symref", "origin", "HEAD"), re.M)
        if not head:
            refuse("cannot tell the default branch of origin")
        also = [f"{o['branch']}:refs/heads/{head[1]}"]  # a plain push: refused unless a fast-forward
    ledger["end"] = {"reason": reason, "end_state": o["end_state"]}
    save(path, ledger, f"ledger: #{o['spec']['number']} ended", *also)
    state_file = runtime(repo)  # disarmed only once pushed: until then end can run again
    state_file.write_text(json.dumps({**json.loads(state_file.read_text()), "armed": False,
                                      "shift_state": "ended"}) + "\n")
    out({"ok": True, **extra, "shift_state": "ended", "end_state": o["end_state"]})


def heartbeat(a):
    """The hook's entry point: a no-op unless an armed shift's lease is or can be this session's."""
    hook = json.loads(sys.stdin.read() or "{}")
    session, cwd = hook.get("session_id"), Path(hook.get("cwd") or os.getcwd()).resolve()
    for state_file in home().glob("*/*/state.json") if session else ():
        try:
            state = json.loads(state_file.read_text())
        except ValueError:
            continue  # an unreadable state refuses its own repo, not every other one
        if (not state.get("armed") or state.get("session_id", session) != session
                or session in state.get("retired", ())):  # a revived-away session never reclaims
            continue
        if "session_id" not in state:  # ADR 0004: the first hook since arm or revive claims it
            target = Path(state["target"])
            if target != cwd and target not in cwd.parents:
                continue
            state_file.write_text(json.dumps({**state, "session_id": session}) + "\n")
        # atomic: is-dead never reads half a beat; one temp per process, as hooks run in parallel
        tmp = state_file.with_name(f"heartbeat.{os.getpid()}.tmp")
        try:
            tmp.write_text(json.dumps({"at": now()}) + "\n")
            os.replace(tmp, tmp.with_name("heartbeat"))
        finally:
            tmp.unlink(missing_ok=True)
        out({"ok": True, "heartbeat": now()})
    out({"ok": True, "heartbeat": None})


def death(state_file):
    """Whether the shift is dead (spec: Revival), and why."""
    state = json.loads(state_file.read_text()) if state_file.exists() else {}
    if not state.get("armed"):
        return False, "no shift is armed"
    if state["shift_state"] == "waiting" or state.get("pause") == "owner":
        return False, f"{state['shift_state']} on the builder"  # map #10: never dead
    beat = state_file.with_name("heartbeat")
    last = max(datetime.fromisoformat(t) for t in (
        state["since"], *([json.loads(beat.read_text())["at"]] if beat.exists() else [])))
    deadline = last + SILENCE
    if state["shift_state"] == "paused":  # a planned pause: dead only past the reset + 15 min
        deadline = max(deadline, datetime.fromisoformat(state["until"]) + PAUSE_GRACE)
    if datetime.fromisoformat(now()) < deadline:
        return False, f"{state['shift_state']}; dead from {deadline.isoformat()} if silent"
    return True, f"{state['shift_state']} and silent since {last.isoformat()}"


def is_dead(a):
    dead, why = death(runtime(this_repo()))
    out({"ok": True, "dead": dead, "why": why})


def revive(a):
    repo, path, ledger = load()
    state_file = runtime(repo)
    dead, why = death(state_file)
    if not dead:
        refuse(f"the shift is not dead: {why}")
    state = json.loads(state_file.read_text())
    gen, revivals = state["gen"] + 1, state.get("revivals", 0) + 1
    n = next((n for n, t in ledger["tickets"].items() if t["state"] == "In progress"), None)
    if n:
        t = ledger["tickets"][n]
        t["crashes"] = t.get("crashes", 0) + 1
        if t["crashes"] >= CRASHES:
            t.update(state="Needs you", reason="set aside after a crash",
                     why=f"in progress during {t['crashes']} crashes")
    ref = None
    if run("git", "status", "--porcelain"):  # set the work aside without touching the tree
        ref = f"refs/third-shift/{path.stem}/set-aside-{gen}"
        with tempfile.TemporaryDirectory() as tmp:
            env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp, "index"))}
            run("git", "add", "-A", env=env)
            tree = run("git", "write-tree", env=env)
        run("git", "update-ref", ref, run("git", "commit-tree", tree, "-p", "HEAD", "-m",
                                          f"third-shift: set aside at revival {gen}"))
    if state["shift_state"] == "paused":  # spec: a revival is a transition back to running
        ledger["pauses"][-1]["resumed"] = now()
    ledger.setdefault("revivals", []).append({"at": now(), "gen": gen,
                                              "ticket": n and int(n), "set_aside": ref})
    try:
        save(path, ledger, f"ledger: #{ledger['opening']['spec']['number']} revived",
             *([f"{ref}:{ref}"] if ref else []))
    except Exception:
        if ref:
            subprocess.run(["git", "update-ref", "-d", ref], capture_output=True)
        raise
    if ref:  # spec: restart the ticket from its last commit
        run("git", "reset", "-q", "--hard")
        run("git", "clean", "-q", "-fd", "--", ":/")
    retired = [*state.get("retired", []), *([state["session_id"]] if "session_id" in state else [])]
    state = {k: v for k, v in state.items() if k not in ("session_id", "until", "pause")}
    state_file.write_text(json.dumps({**state, "gen": gen, "revivals": revivals, "since": now(),
                                      "retired": retired,  # the next hook, never these, claims
                                      "shift_state": "running"}) + "\n")
    result = {"gen": gen, "revivals": revivals, "ticket": n and int(n),
              "ticket_state": n and ledger["tickets"][n]["state"], "set_aside": ref}
    if revivals >= REVIVALS:
        finish(repo, path, ledger, "three revivals", **result)
    out({"ok": True, **result, "shift_state": "running"})


class Parser(argparse.ArgumentParser):
    def error(self, message):  # ADR 0003 keeps exit 2 for a lost lease
        refuse(message)


def at_least(low):
    def check(v):
        if int(v) < low:
            raise ValueError(v)
        return int(v)
    check.__name__ = f"whole number {low} or more"  # argparse names the type in its error
    return check


def percent(v):
    if not 0 <= int(v) <= 100:
        raise ValueError(v)
    return int(v)


def text(v):
    if not v.strip():
        raise ValueError(v)
    return v


text.__name__ = "non-blank text"


def timestamp(v):
    datetime.fromisoformat(v)
    return v


def zoned(v):
    if datetime.fromisoformat(v).tzinfo is None:
        raise ValueError(v)
    return v


zoned.__name__ = "timestamp with a timezone"


def main():
    p = Parser(prog="shift")
    sub = p.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("arm")
    s.add_argument("--prescan", required=True)
    s.add_argument("--sitting", required=True)
    s.add_argument("--mode", required=True, choices=["day", "away"])
    s.add_argument("--ceiling", default=str(CEILING))
    s = sub.add_parser("next")
    s.add_argument("--gen", type=int, required=True)
    for cmd in ("admit", "step"):
        s = sub.add_parser(cmd)
        s.add_argument("ticket", type=int)
        s.add_argument("--gen", type=int, required=True)
        s.add_argument("--5h", dest="five_hour", type=percent)
        s.add_argument("--reset", type=zoned)
        s.add_argument("--weekly", action="append", type=percent)
        s.add_argument("--unreadable", action="store_true")
        s.add_argument("--guess", type=at_least(0))
    s.add_argument("--begin", action="store_true")
    s.add_argument("--role", required=True, choices=ROLES)
    s.add_argument("--round", type=at_least(1))
    for f in ("model", "effort", "outcome"):
        s.add_argument(f"--{f}")
    for f in ("before-5h", "before-weekly", "after-5h", "after-weekly"):
        s.add_argument(f"--{f}", type=percent)
    for f in ("start", "end"):
        s.add_argument(f"--{f}", type=timestamp)
    s.add_argument("--tokens", type=at_least(0))
    s = sub.add_parser("done")
    s.add_argument("ticket", type=int)
    s.add_argument("--gen", type=int, required=True)
    s.add_argument("--comment", required=True)
    for cmd, flags in (("needs-you", ("reason", "why")), ("stall", ("why",)), ("release", ())):
        s = sub.add_parser(cmd)
        s.add_argument("ticket", type=int)
        s.add_argument("--gen", type=int, required=True)
        for f in flags:
            s.add_argument(f"--{f}", required=True, type=text, **(
                {"choices": REASONS} if f == "reason" else {}))
    s.add_argument("--decision", type=text)
    s = sub.add_parser("note")
    s.add_argument("kind", choices=("decision", "owed", "nit"))
    s.add_argument("ticket", type=int)
    s.add_argument("--gen", type=int, required=True)
    s.add_argument("--text", required=True, type=text)
    s.add_argument("--for", dest="for_", type=int)
    s = sub.add_parser("pause")
    s.add_argument("--gen", type=int, required=True)
    s.add_argument("--reason", required=True, choices=("usage", "owner"))  # spec: Shift states
    s.add_argument("--until", required=True, type=zoned)
    s = sub.add_parser("resume")
    s.add_argument("--gen", type=int, required=True)
    s = sub.add_parser("wait")
    s.add_argument("--gen", type=int, required=True)
    s = sub.add_parser("end")
    s.add_argument("--gen", type=int, required=True)
    s.add_argument("--reason", required=True, type=text)
    for cmd in ("heartbeat", "is-dead", "revive"):
        sub.add_parser(cmd)
    a = p.parse_args()
    try:
        {"arm": arm, "next": next_, "admit": admit, "step": step, "done": done,
         "needs-you": needs_you, "stall": stall, "release": release, "note": note,
         "pause": pause, "resume": resume, "wait": wait, "end": end, "heartbeat": heartbeat,
         "is-dead": is_dead, "revive": revive}[a.cmd](a)
    except subprocess.CalledProcessError as e:
        refuse(f"{' '.join(e.cmd)} failed: {(e.stdout + e.stderr).strip()}")
    except Exception as e:  # ADR 0003: one JSON object, never a stack trace
        refuse(f"{type(e).__name__}: {e}")


if __name__ == "__main__":
    main()
