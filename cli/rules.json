{
  "about": "ADR 0006: the allow list and deny rules for user settings, and the permissions keys in set (map #4). setup writes them; the prescan checks every one is present. The guard hook, not these rules, is the safety boundary.",
  "allow": [
    "Skill(third-shift:start)",
    "Skill(third-shift:start *)",
    "Bash(uv run --script *cli/shift*)",
    "Bash(uv run --script *cli/prescan*)",
    "Bash(git status *)",
    "Bash(git diff *)",
    "Bash(git log *)",
    "Bash(git rev-parse *)",
    "Bash(git add *)",
    "Bash(git commit *)",
    "Bash(git switch *)",
    "Bash(git push origin third-shift/*)",
    "Bash(gh issue view *)",
    "Bash(gh issue list *)",
    "Bash(gh issue comment *)",
    "Bash(gh issue close *)",
    "Bash(gh issue edit *)",
    "Bash(verify/checks)",
    "Bash(./verify/checks)",
    "Bash(npx playwright test *)",
    "Bash(playwright-cli *)",
    "Bash(mkdir -p .git/third-shift*)",
    "Skill(dempsey-skills:security-preflight)",
    "mcp__scheduled-tasks__delete_scheduled_task",
    "mcp__ccd_directory__change_directory"
  ],
  "deny": [
    "Bash(git push *--force*)",
    "Bash(git push * -f*)",
    "Bash(git push *--delete*)",
    "Bash(git push *--mirror*)",
    "Bash(git branch -D *)",
    "Bash(gh repo delete *)",
    "Bash(gh issue delete *)",
    "Bash(gh release delete *)",
    "Bash(gh pr merge *)",
    "Bash(gh repo edit *)",
    "Bash(gh api -X DELETE *)"
  ],
  "set": {
    "blockWritesOutsideWorkingDirectories": true
  }
}
